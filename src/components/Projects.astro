---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { projects } from '../data/profile';

// A screenshot of each live site, at src/assets/projects/<project id>.{png,jpg,webp}.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const shots = new Map(
  Object.entries(files).map(([path, mod]) => [path.split('/').pop()!.replace(/\.\w+$/, ''), mod.default]),
);
---

<ul class="projects" role="list">
  {
    projects.map((p) => (
      <li class="project">
        <h3>{p.name}</h3>
        {shots.has(p.id) && (
          // The buttons below carry the same link, so this one stays out of the tab order.
          <a class="shot" href={p.live} tabindex="-1" aria-hidden="true">
            <Image src={shots.get(p.id)!} alt="" widths={[480, 960, 1440]} sizes="(min-width: 64rem) 46rem, 100vw" />
          </a>
        )}
        <p class="muted summary">{p.summary}</p>
        <ul class="points">
          {p.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
        <ul class="tags" role="list" aria-label="Stack">
          {p.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        <p class="actions">
          <a class="button primary" href={p.live}>
            Visit site<span class="sr-only">: {p.name}</span>
          </a>
          <a class="button" href={p.source}>
            Source code<span class="sr-only">: {p.name}</span>
          </a>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    display: grid;
    gap: 3rem;
  }

  .shot {
    display: block;
    margin-block: 0.6rem 0.75rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.2s ease;
  }

  .shot:hover :global(img) {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(img) {
      transition: none;
    }
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .summary {
    margin-top: 0.15rem;
    text-wrap: pretty;
  }

  .points {
    margin-top: 0.6rem;
    padding-left: 1.1rem;
    list-style-type: disc;
  }

  .points li + li {
    margin-top: 0.3rem;
  }

  .points li::marker {
    color: var(--muted);
  }

  .tags {
    margin-top: 0.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--button-border);
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--text);
  }

  .primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .primary:hover {
    opacity: 0.85;
  }

  @media (max-width: 30rem) {
    .points {
      padding-left: 1rem;
    }
  }

  @media print {
    .projects > li {
      break-inside: avoid;
    }

    .shot,
    .actions {
      display: none;
    }
  }
</style>
