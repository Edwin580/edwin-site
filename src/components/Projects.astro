---
import { projects } from '../data/profile';
---

<ul class="projects" role="list">
  {
    projects.map((p) => (
      <li>
        <h3>{p.name}</h3>
        <p class="description">{p.description}</p>
        <p class="muted meta">
          <span>{p.stack.join(', ')}</span>
          {p.live && (
            <a href={p.live}>
              Live site<span class="sr-only"> for {p.name}</span>
            </a>
          )}
          <a href={p.source}>
            Source<span class="sr-only"> for {p.name}</span>
          </a>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    display: grid;
    gap: 2rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .description {
    margin-top: 0.25rem;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    margin-top: 0.15rem;
    font-size: 0.875rem;
  }

  /* Taller hit area for the links on touch screens. */
  .meta a {
    display: inline-block;
    padding-block: 0.4rem;
  }

  .meta a:hover {
    color: var(--text);
  }
</style>
