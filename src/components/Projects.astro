---
import { projects } from '../data/profile';
---

<ul class="projects" role="list">
  {
    projects.map((p) => (
      <li>
        <h3>{p.name}</h3>
        <p class="description">{p.description}</p>
        <p class="muted stack">{p.stack.join(', ')}</p>
        <p class="actions">
          {p.live && (
            <a class="button primary" href={p.live}>
              Visit site<span class="sr-only">: {p.name}</span>
            </a>
          )}
          <a class="button" href={p.source}>
            Source code<span class="sr-only">: {p.name}</span>
          </a>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    display: grid;
    gap: 2.25rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .description {
    margin-top: 0.25rem;
    text-wrap: pretty;
  }

  .stack {
    margin-top: 0.4rem;
    font-size: 0.875rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--button-border);
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--text);
  }

  .primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .primary:hover {
    opacity: 0.85;
  }

  @media print {
    .actions {
      display: none;
    }
  }
</style>
