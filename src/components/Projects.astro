---
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import { projects } from '../data/profile';

// A screenshot of each project, at src/assets/projects/<project id>.{png,jpg,webp}.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const id = (path: string) => path.split('/').pop()!.replace(/\.\w+$/, '');
const shots = new Map(Object.entries(files).map(([path, mod]) => [id(path), mod.default]));

// A short screen recording of each project, at src/assets/demos/<project id>.{mp4,webm} (see scripts/demos/).
// H.264 MP4 plays almost everywhere; the VP9 WebM covers browsers built without H.264.
// The screenshot is the poster, and stands in for the video when motion is reduced.
const clip = (files: Record<string, string>) => new Map(Object.entries(files).map(([path, url]) => [id(path), url]));
const mp4 = clip(import.meta.glob<string>('../assets/demos/*.mp4', { eager: true, query: '?url', import: 'default' }));
const webm = clip(import.meta.glob<string>('../assets/demos/*.webm', { eager: true, query: '?url', import: 'default' }));
const demos = new Set([...mp4.keys(), ...webm.keys()]);
const posters = new Map(
  await Promise.all(
    [...shots].filter(([k]) => demos.has(k)).map(async ([k, src]) => [k, (await getImage({ src, width: 960, format: 'webp' })).src] as const),
  ),
);
---

<ul class="projects" role="list">
  {
    projects.map((p) => (
      <li class="project">
        <h3>{p.name}</h3>
        {shots.has(p.id) && (
          // The buttons below carry the same link, so this one stays out of the tab order.
          <a class="shot" href={p.live ?? p.source} tabindex="-1" aria-hidden="true">
            <Image src={shots.get(p.id)!} alt="" widths={[480, 960, 1440]} sizes="(min-width: 64rem) 46rem, 100vw" />
            {demos.has(p.id) && (
              <video poster={posters.get(p.id)} autoplay muted loop playsinline preload="none">
                {mp4.has(p.id) && <source src={mp4.get(p.id)} type="video/mp4" />}
                {webm.has(p.id) && <source src={webm.get(p.id)} type="video/webm" />}
              </video>
            )}
          </a>
        )}
        <p class="muted summary">{p.summary}</p>
        <details class="how">
          <summary>How it works</summary>
          <ul class="points">
            {p.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </details>
        <ul class="tags" role="list" aria-label="Stack">
          {p.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
        <p class="actions">
          {p.live && (
            <a class="button primary" href={p.live}>
              Visit site<span class="sr-only">: {p.name}</span>
            </a>
          )}
          <a class={p.live ? 'button' : 'button primary'} href={p.source}>
            Source code<span class="sr-only">: {p.name}</span>
          </a>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    display: grid;
    gap: 3rem;
  }

  .shot {
    display: block;
    margin-block: 0.6rem 0.75rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
  }

  .shot {
    position: relative;
  }

  /* The video sits over the screenshot, which still sets the size and shows until the video plays. */
  .shot video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.2s ease;
  }

  .shot:hover video {
    transform: scale(1.02);
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.2s ease;
  }

  .shot:hover :global(img) {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .shot :global(img) {
      transition: none;
    }

    .how summary::before {
      transition: none;
    }

    .shot video {
      display: none;
    }
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .summary {
    margin-top: 0.15rem;
    text-wrap: pretty;
  }

  .how {
    margin-top: 0.6rem;
  }

  .how summary {
    width: fit-content;
    min-height: 2.25rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .how summary::-webkit-details-marker {
    display: none;
  }

  .how summary::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
  }

  .how[open] summary::before {
    transform: rotate(45deg);
  }

  .how summary:hover {
    color: var(--text);
  }

  .points {
    margin-top: 0.2rem;
    padding-left: 1.1rem;
    list-style-type: disc;
  }

  .points li + li {
    margin-top: 0.3rem;
  }

  .points li::marker {
    color: var(--muted);
  }

  .tags {
    margin-top: 0.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.85rem;
    border: 1px solid var(--button-border);
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--text);
  }

  .primary {
    border-color: var(--text);
    background: var(--text);
    color: var(--bg);
  }

  .primary:hover {
    opacity: 0.85;
  }

  @media (max-width: 30rem) {
    .points {
      padding-left: 1rem;
    }
  }

  @media print {
    .projects > li {
      break-inside: avoid;
    }

    .shot,
    .actions,
    .how summary {
      display: none;
    }

    /* Print the bullets whether or not the dropdown is open. */
    .how::details-content {
      content-visibility: visible;
    }
  }
</style>
