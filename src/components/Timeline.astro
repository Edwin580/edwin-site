---
import { roles, toIndex, fmt, duration, type YM } from '../data/profile';

const now = new Date();
const nowYM = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}` as YM;

const lo = Math.min(...roles.map((r) => toIndex(r.start)));
const hi = Math.max(toIndex(nowYM), ...roles.map((r) => toIndex(r.end))) + 1;
const span = hi - lo;
const pct = (i: number) => `${(((i - lo) / span) * 100).toFixed(3)}%`;

const years: number[] = [];
for (let y = Math.ceil(lo / 12); y * 12 < hi; y++) years.push(y);
---

<figure class="timeline" aria-labelledby="timeline-caption">
  <figcaption id="timeline-caption" class="sr-only">
    Timeline of roles from {fmt(roles.at(-1)!.start)} to {fmt(roles[0]!.end)}
  </figcaption>

  <div class="axis mono muted" aria-hidden="true">
    {years.map((y) => <span style={`--x:${pct(y * 12)}`}>{y}</span>)}
    <span class="now" style={`--x:${pct(toIndex(nowYM) + 0.5)}`}>now</span>
  </div>

  <div class="plot">
    <div class="grid" aria-hidden="true">
      {years.map((y) => <span style={`--x:${pct(y * 12)}`} />)}
      <span class="now" style={`--x:${pct(toIndex(nowYM) + 0.5)}`} />
    </div>

  <ol role="list">
    {
      roles.map((r, i) => (
        <li style={`--s:${pct(toIndex(r.start))};--e:${pct(toIndex(r.end) + 1)};--i:${i}`}>
          <a href={`#${r.id}`} class="row" data-role={r.id}>
            <span class="label mono">{r.short}</span>
            <span class="track">
              <span class={`bar ${r.kind}`}>
                <span class="sr-only">
                  {r.org}, {fmt(r.start)} to {fmt(r.end)}
                </span>
              </span>
              <span class:list={['len mono', { flip: toIndex(r.start) - lo > span / 2 }]} aria-hidden="true">{duration(r)}mo</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
  </div>

  <ul class="legend mono muted" role="list" aria-hidden="true">
    <li><i class="engineering" /> engineering</li>
    <li><i class="data" /> data</li>
    <li><i class="research" /> research</li>
  </ul>
</figure>

<style>
  .timeline {
    --label: 5.5rem;
    position: relative;
    display: grid;
    gap: 0.4rem;
  }

  .axis,
  .grid {
    position: relative;
    margin-left: var(--label);
  }

  .axis {
    height: 1.2rem;
  }

  .axis span {
    position: absolute;
    left: var(--x);
  }

  .axis .now {
    translate: -100% 0;
    padding-right: 0.3rem;
    color: var(--accent);
  }

  .plot {
    position: relative;
  }

  .grid {
    position: absolute;
    inset: 0 0 0 var(--label);
    margin: 0;
    pointer-events: none;
  }

  .grid span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x);
    border-left: 1px dashed var(--faint);
  }

  .grid .now {
    border-left: 1px solid var(--accent);
  }

  ol {
    position: relative;
    display: grid;
    gap: 2px;
  }

  .row {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    align-items: center;
    height: 1.75rem;
    text-decoration: none;
    border-radius: 4px;
  }

  .label {
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .track {
    position: relative;
    height: 100%;
  }

  .bar {
    position: absolute;
    top: 50%;
    left: var(--s);
    width: calc(var(--e) - var(--s));
    height: 0.6rem;
    translate: 0 -50%;
    border-radius: 2px;
    transform-origin: left;
    transition: height 0.25s var(--ease), background-color 0.2s;
  }

  .engineering {
    background: var(--accent);
  }

  .data {
    background: color-mix(in oklch, var(--fg) 55%, transparent);
  }

  .research {
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in oklch, var(--fg) 45%, transparent) 0 2px,
      transparent 2px 5px
    );
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--fg) 45%, transparent);
  }

  .len {
    position: absolute;
    top: 50%;
    left: calc(var(--e) + 0.5rem);
    translate: 0 -50%;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .len.flip {
    left: auto;
    right: calc(100% - var(--s) + 0.5rem);
  }

  .row:hover .label,
  .row:focus-visible .label,
  .row.is-active .label {
    color: var(--fg);
  }

  .row:hover .bar,
  .row:focus-visible .bar,
  .row.is-active .bar {
    height: 1rem;
  }

  .row:hover .len,
  .row:focus-visible .len,
  .row.is-active .len {
    opacity: 1;
  }

  /* Dim siblings while one row is in focus. */
  ol:has(.row:hover, .row.is-active) .row:not(:hover, .is-active) .bar {
    opacity: 0.35;
  }

  .legend {
    display: flex;
    gap: 1rem;
    margin: 0.6rem 0 0 var(--label);
    font-size: 0.7rem;
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legend i {
    width: 0.9rem;
    height: 0.45rem;
    border-radius: 1px;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bar {
        animation: grow linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
    }
  }

  @keyframes grow {
    from {
      scale: 0 1;
    }
  }

  @media (max-width: 30rem) {
    .timeline {
      --label: 4.2rem;
    }
  }
</style>
