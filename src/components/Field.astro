---
/**
 * Interactive dot field behind the hero. A spring-mass grid that yields to the
 * pointer and breathes with a travelling wave. Pure canvas 2D, no deps.
 */
---

<canvas class="field" aria-hidden="true"></canvas>

<style>
  .field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(120% 90% at 70% 30%, #000 30%, transparent 75%);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.field');
  const ctx = canvas?.getContext('2d');

  if (canvas && ctx) {
    const host = canvas.parentElement!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const GAP = 22;
    const RADIUS = 140;
    const STIFF = 0.06;
    const DAMP = 0.86;

    let w = 0, h = 0, dpr = 1, n = 0;
    // Rest position, offset and velocity per dot, packed for cache locality.
    let rx = new Float32Array(0), ry = rx, ox = rx, oy = rx, vx = rx, vy = rx;
    let fg = '#000', accent = '#f60';
    let px = -1e4, py = -1e4, raf = 0, visible = true, t0 = performance.now();

    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      fg = cs.getPropertyValue('--muted').trim() || fg;
      accent = cs.getPropertyValue('--accent').trim() || accent;
    };

    const layout = () => {
      const r = host.getBoundingClientRect();
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const cols = Math.ceil(w / GAP) + 1;
      const rows = Math.ceil(h / GAP) + 1;
      n = cols * rows;
      rx = new Float32Array(n); ry = new Float32Array(n);
      ox = new Float32Array(n); oy = new Float32Array(n);
      vx = new Float32Array(n); vy = new Float32Array(n);
      const offX = (w - (cols - 1) * GAP) / 2;
      for (let i = 0; i < n; i++) {
        rx[i] = offX + (i % cols) * GAP;
        ry[i] = Math.floor(i / cols) * GAP + GAP / 2;
      }
    };

    const frame = (now: number) => {
      const t = (now - t0) / 1000;
      ctx.clearRect(0, 0, w, h);
      const r2 = RADIUS * RADIUS;

      for (let i = 0; i < n; i++) {
        const dx = rx[i]! + ox[i]! - px;
        const dy = ry[i]! + oy[i]! - py;
        const d2 = dx * dx + dy * dy;
        let near = 0;

        if (d2 < r2) {
          const d = Math.sqrt(d2) || 1;
          near = 1 - d / RADIUS;
          const f = near * near * 2.4;
          vx[i]! += (dx / d) * f;
          vy[i]! += (dy / d) * f;
        }

        vx[i] = (vx[i]! - ox[i]! * STIFF) * DAMP;
        vy[i] = (vy[i]! - oy[i]! * STIFF) * DAMP;
        ox[i]! += vx[i]!;
        oy[i]! += vy[i]!;

        const wave = Math.sin(rx[i]! * 0.012 + ry[i]! * 0.02 - t * 1.2) * 0.5 + 0.5;
        const size = 0.6 + wave * 0.7 + near * 1.6;

        ctx.globalAlpha = 0.22 + wave * 0.3 + near * 0.6;
        ctx.fillStyle = near > 0.15 ? accent : fg;
        ctx.fillRect(rx[i]! + ox[i]! - size / 2, ry[i]! + oy[i]! - size / 2, size, size);
      }
      ctx.globalAlpha = 1;
    };

    const loop = (now: number) => {
      frame(now);
      raf = visible && !reduce.matches ? requestAnimationFrame(loop) : 0;
    };

    const start = () => {
      if (!raf && visible && !reduce.matches) raf = requestAnimationFrame(loop);
      else if (reduce.matches) frame(t0);
    };

    readColors();
    layout();
    start();

    new ResizeObserver(() => { layout(); if (!raf) frame(performance.now()); }).observe(host);
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; start(); }).observe(host);
    new MutationObserver(() => { readColors(); if (!raf) frame(performance.now()); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { readColors(); start(); });
    reduce.addEventListener('change', start);
    document.addEventListener('visibilitychange', () => { visible = !document.hidden; start(); });

    addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      px = e.clientX - r.left;
      py = e.clientY - r.top;
    }, { passive: true });
    document.addEventListener('pointerleave', () => { px = py = -1e4; });
  }
</script>
