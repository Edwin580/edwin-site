---
import { profile } from '../data/profile';

interface Command {
  id: string;
  label: string;
  hint: string;
  group: 'Navigate' | 'Links' | 'Actions';
  href?: string;
}

const commands: Command[] = [
  { id: 'nav-timeline', label: 'Timeline', hint: '#timeline', group: 'Navigate', href: '#timeline' },
  { id: 'nav-experience', label: 'Experience', hint: '#experience', group: 'Navigate', href: '#experience' },
  { id: 'nav-projects', label: 'Projects', hint: '#projects', group: 'Navigate', href: '#projects' },
  { id: 'link-github', label: 'GitHub', hint: '↗', group: 'Links', href: profile.links.github },
  { id: 'link-linkedin', label: 'LinkedIn', hint: '↗', group: 'Links', href: profile.links.linkedin },
  { id: 'email', label: 'Copy email', hint: profile.email, group: 'Actions' },
  { id: 'theme', label: 'Toggle theme', hint: 'T', group: 'Actions' },
];
---

<dialog class="palette" aria-label="Command menu" data-email={profile.email}>
  <form method="dialog">
    <input
      type="text"
      placeholder="Type a command…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
    />
    <ul id="palette-list" role="listbox">
      {
        commands.map((c) => (
          <li
            role="option"
            id={c.id}
            data-group={c.group}
            data-href={c.href}
            data-label={c.label.toLowerCase()}
            aria-selected="false"
          >
            <span>{c.label}</span>
            <span class="mono muted">{c.hint}</span>
          </li>
        ))
      }
    </ul>
    <p class="foot mono muted">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> select</span>
      <span><kbd>esc</kbd> close</span>
    </p>
  </form>
</dialog>

<style>
  .palette {
    width: min(32rem, calc(100vw - 2rem));
    margin: 18vh auto auto;
    padding: 0;
    border: 1px solid var(--faint);
    border-radius: 12px;
    background: color-mix(in oklch, var(--bg) 88%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    color: var(--fg);
    box-shadow:
      0 1px 0 color-mix(in oklch, var(--fg) 6%, transparent) inset,
      0 24px 60px -12px rgb(0 0 0 / 0.35);
    overflow: hidden;
  }

  .palette[open] {
    animation: pop 0.18s var(--ease);
  }

  .palette::backdrop {
    background: rgb(0 0 0 / 0.25);
    backdrop-filter: blur(2px);
  }

  input {
    width: 100%;
    padding: 1rem 1.1rem;
    border: 0;
    border-bottom: 1px solid var(--faint);
    background: transparent;
    color: inherit;
    font: inherit;
    outline: none;
  }

  ul {
    list-style: none;
    padding: 0.4rem;
    margin: 0;
    max-height: 50vh;
    overflow-y: auto;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    cursor: pointer;
  }

  li[aria-selected='true'] {
    background: var(--surface);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  li[hidden] {
    display: none;
  }

  .foot {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--faint);
    font-size: 0.7rem;
  }

  .foot kbd + kbd {
    margin-left: 2px;
  }

  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.98;
      translate: 0 -4px;
    }
  }
</style>

<script>
  import { toggleTheme } from '../scripts/theme';

  const dialog = document.querySelector<HTMLDialogElement>('dialog.palette')!;
  const input = dialog.querySelector('input')!;
  const items = [...dialog.querySelectorAll<HTMLLIElement>('li[role=option]')];
  let active = 0;

  const visible = () => items.filter((i) => !i.hidden);

  const select = (idx: number) => {
    const list = visible();
    if (!list.length) return;
    active = (idx + list.length) % list.length;
    items.forEach((i) => i.setAttribute('aria-selected', 'false'));
    const el = list[active]!;
    el.setAttribute('aria-selected', 'true');
    input.setAttribute('aria-activedescendant', el.id);
    el.scrollIntoView({ block: 'nearest' });
  };

  const open = () => {
    input.value = '';
    items.forEach((i) => (i.hidden = false));
    dialog.showModal();
    select(0);
  };

  const run = async (el: HTMLLIElement) => {
    dialog.close();
    const href = el.dataset.href;
    if (href?.startsWith('#')) {
      document.querySelector(href)?.scrollIntoView();
      history.replaceState(null, '', href);
    } else if (href) {
      window.open(href, '_blank', 'noopener');
    } else if (el.id === 'email') {
      await navigator.clipboard?.writeText(dialog.dataset.email ?? '');
      document.dispatchEvent(new CustomEvent('toast', { detail: 'Email copied' }));
    } else if (el.id === 'theme') {
      toggleTheme();
    }
  };

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    // Subsequence match: "gh" finds "github", "cpe" finds "copy email".
    const re = new RegExp([...q].map((c) => c.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('.*'));
    items.forEach((i) => (i.hidden = !re.test(i.dataset.label ?? '')));
    select(0);
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); select(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); select(active - 1); }
    else if (e.key === 'Enter') {
      e.preventDefault();
      const el = visible()[active];
      if (el) void run(el);
    }
  });

  dialog.addEventListener('click', (e) => {
    const li = (e.target as HTMLElement).closest<HTMLLIElement>('li[role=option]');
    if (li) void run(li);
    else if (e.target === dialog) dialog.close(); // backdrop click
  });

  document.addEventListener('keydown', (e) => {
    const typing = (e.target as HTMLElement).closest('input, textarea, [contenteditable]');
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dialog.open ? dialog.close() : open();
    } else if (!typing && !dialog.open && e.key === '/') {
      e.preventDefault();
      open();
    } else if (!typing && !dialog.open && e.key.toLowerCase() === 't' && !e.metaKey && !e.ctrlKey && !e.altKey) {
      toggleTheme();
    }
  });

  document.addEventListener('palette:open', open);
</script>
