---
import { roles, dateRange } from '../data/profile';
---

<ol class="roles" role="list">
  {
    roles.map((r) => (
      <li class="role">
        <div class="head">
          <div class="top">
            <h3>{r.org}</h3>
            <p class="muted dates">
              <time datetime={r.start}>{dateRange(r)}</time>
            </p>
          </div>
          <p class="muted">
            {r.title}, {r.location}
          </p>
        </div>
        <div class="body">
          <ul class="points">
            {r.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <ul class="tags" role="list" aria-label="Stack">
            {r.stack.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .roles {
    display: grid;
    gap: 2.25rem;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 1rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .dates {
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .points {
    margin-top: 0.6rem;
    padding-left: 1.1rem;
    list-style-type: disc;
  }

  .points li + li {
    margin-top: 0.3rem;
  }

  .points li::marker {
    color: var(--muted);
  }

  .tags {
    margin-top: 0.75rem;
  }

  /* On phones the dates drop under the company name. */
  @media (max-width: 30rem) {
    .top {
      flex-direction: column;
    }

    .points {
      padding-left: 1rem;
    }
  }

  @media print {
    .role {
      break-inside: avoid;
    }
  }
</style>
