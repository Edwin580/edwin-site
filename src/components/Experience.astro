---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { roles, dateRange } from '../data/profile';

// Drop a logo at src/assets/logos/<role id>.{svg,png,jpg,webp} and it's picked up here.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/logos/*.{svg,png,jpg,jpeg,webp}', {
  eager: true,
});
const logos = new Map(
  Object.entries(files).map(([path, mod]) => [path.split('/').pop()!.replace(/\.\w+$/, ''), mod.default]),
);
---

<ol class="roles" role="list">
  {
    roles.map((r) => (
      <li class="role">
        <span class="logo" aria-hidden="true">
          {logos.has(r.id) ? (
            <Image src={logos.get(r.id)!} alt="" width={36} height={36} densities={[1, 2, 3]} />
          ) : (
            <span>{r.monogram ?? r.org.charAt(0)}</span>
          )}
        </span>
        <div class="head">
          <div class="top">
            <h3>{r.org}</h3>
            <p class="muted dates">
              <time datetime={r.start}>{dateRange(r)}</time>
            </p>
          </div>
          <p class="muted">
            {r.title}, {r.location}
          </p>
        </div>
        <div class="body">
          <ul class="points">
            {r.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
          <p class="muted stack">{r.stack.join(', ')}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .roles {
    display: grid;
    gap: 2.25rem;
  }

  .role {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    column-gap: 1rem;
  }

  .head,
  .body {
    grid-column: 2;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-top: 0.1rem;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #fff;
    color: #171717;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 1rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
  }

  .dates {
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .points {
    margin-top: 0.6rem;
    padding-left: 1.1rem;
    list-style-type: disc;
  }

  .points li + li {
    margin-top: 0.3rem;
  }

  .points li::marker {
    color: var(--muted);
  }

  .stack {
    margin-top: 0.6rem;
    font-size: 0.875rem;
  }

  /* On phones the logo stays beside the company, the dates drop under it,
     and the bullets use the full width. */
  @media (max-width: 30rem) {
    .role {
      column-gap: 0.75rem;
    }

    .top {
      flex-direction: column;
    }

    .body {
      grid-column: 1 / -1;
    }

    .points {
      padding-left: 1rem;
    }
  }

  @media print {
    .role {
      break-inside: avoid;
    }
  }
</style>
