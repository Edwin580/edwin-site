---
import { roles, fmt } from '../data/profile';

const range = (r: (typeof roles)[number]) => {
  const [s, e] = [fmt(r.start), fmt(r.end)];
  // Collapse the year when a role starts and ends in the same one.
  return s.slice(-4) === e.slice(-4) ? `${s.slice(0, 3)} – ${e}` : `${s} – ${e}`;
};
---

<ol class="experience cards" role="list">
  {
    roles.map((r) => (
      <li id={r.id}>
        <article class="card">
          <header>
            <h3>{r.org}</h3>
            <p class="when mono muted">
              <time datetime={r.start}>{range(r)}</time>
            </p>
          </header>
          <p class="meta muted">
            {r.title} <span aria-hidden="true">·</span> {r.location}
          </p>
          <ul class="highlights" role="list">
            {r.highlights.map((h) => <li>{h}</li>)}
          </ul>
          <ul class="chips mono" role="list" aria-label="Stack">
            {r.stack.map((s) => <li>{s}</li>)}
          </ul>
        </article>
      </li>
    ))
  }
</ol>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .when {
    font-variant-numeric: tabular-nums;
  }

  .meta {
    margin-top: 0.15rem;
  }

  .highlights {
    display: grid;
    gap: 0.3rem;
    margin-top: 0.85rem;
  }

  .highlights li {
    position: relative;
    padding-left: 1.1rem;
    color: color-mix(in oklch, var(--fg) 85%, var(--bg));
    text-wrap: pretty;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.68em;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: var(--accent);
    opacity: 0.85;
  }

  @media (max-width: 36rem) {
    header {
      flex-direction: column;
    }
  }
</style>
