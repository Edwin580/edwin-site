---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { profile } from '../data/profile';
import portrait from '../assets/edwin.jpg';

const title = profile.name;
const description = `${profile.name} is a ${profile.role.toLowerCase()} in ${profile.location}. Experience, projects, and resume.`;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Set by the Preview workflow; production builds leave both empty.
const preview = process.env.PREVIEW ? (process.env.PR_NUMBER ?? '') : null;

const [icon, touchIcon, og] = await Promise.all([
  getImage({ src: portrait, width: 64, height: 64, format: 'png' }),
  getImage({ src: portrait, width: 180, height: 180, format: 'png' }),
  getImage({ src: portrait, width: 600, height: 600, format: 'jpg' }),
]);
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: canonical.href,
  image: ogUrl,
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={icon.src} type="image/png" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131313" media="(prefers-color-scheme: dark)" />
    {preview !== null && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={profile.name} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    {
      preview !== null && (
        <a class="preview-badge" href={`https://github.com/Edwin580/edwin-site/pull/${preview}`}>
          Preview{preview && ` of PR #${preview}`}
        </a>
      )
    }
  </body>
</html>

<style>
  .preview-badge {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    background: #d9480f;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }
</style>
