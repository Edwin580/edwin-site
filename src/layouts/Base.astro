---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { profile } from '../data/profile';
import portrait from '../assets/edwin.jpg';
import card from '../assets/og.png';

const title = `${profile.name} · ${profile.role}`;
const description = `${profile.name} is a ${profile.role.toLowerCase()} in ${profile.location}. Experience, projects, and resume.`;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Set by the Preview workflow; production builds leave both empty.
const preview = process.env.PREVIEW ? (process.env.PR_NUMBER ?? '') : null;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// The 1200x630 card fills link previews (LinkedIn, iMessage, Slack) without cropping;
// see scripts/og-card.mjs. The square portrait stays the Person image for search.
// JPEG is a third the size of the PNG. LinkedIn caches images by URL, so changing this changes what it fetches.
const [og, photo] = await Promise.all([
  getImage({ src: card, format: 'jpg', quality: 90 }),
  getImage({ src: portrait, width: 600, height: 600, format: 'jpg' }),
]);
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: canonical.href,
  image: new URL(photo.src, Astro.site).href,
  sameAs: Object.values(profile.links),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}apple-touch-icon.png`} type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131313" media="(prefers-color-scheme: dark)" />
    {preview !== null && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:secure_url" content={ogUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role.toLowerCase()} in ${profile.location}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    {
      preview !== null && (
        <a class="preview-badge" href={`https://github.com/Edwin580/edwin-site/pull/${preview}`}>
          Preview{preview && ` of PR #${preview}`}
        </a>
      )
    }
  </body>
</html>

<style>
  .preview-badge {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.4rem 0.7rem;
    border-radius: 6px;
    background: #d9480f;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }
</style>
