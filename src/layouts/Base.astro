---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { profile } from '../data/profile';
import portrait from '../assets/edwin.jpg';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.tagline}`,
  description = `${profile.tagline} in ${profile.location}. ${profile.about}.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`;

const og = await getImage({ src: portrait, width: 600, height: 600, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.tagline,
  email: `mailto:${profile.email}`,
  url: canonical.href,
  image: ogUrl,
  sameAs: Object.values(profile.links),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Vassar College' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <meta name="theme-color" content="#f9f8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141412" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content={profile.name} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Resolve theme before first paint to avoid a flash. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
