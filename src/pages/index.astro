---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import { profile } from '../data/profile';

const resume = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${profile.resume}`;
---

<Base>
  <a class="skip" href="#main">Skip to content</a>

  <div class="page">
    <header>
      <div class="intro">
        <h1>{profile.name}</h1>
        <p class="muted">{profile.role} in {profile.location}</p>
      </div>

      <nav aria-label="Contact">
        <ul class="links" role="list">
          <li><a href={resume}>Resume</a></li>
          <li><a href={profile.links.github} rel="me">GitHub</a></li>
          <li><a href={profile.links.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
        </ul>
      </nav>

      <nav class="toc" aria-label="Sections">
        <ul role="list">
          <li><a href="#experience">Experience</a></li>
          <li><a href="#projects">Projects</a></li>
        </ul>
      </nav>
    </header>

    <main id="main">
      <section aria-labelledby="experience">
        <h2 id="experience">Experience</h2>
        <Experience />
      </section>

      <section aria-labelledby="projects">
        <h2 id="projects">Projects</h2>
        <Projects />
      </section>
    </main>

    <footer class="muted">
      <p>{profile.name}, {new Date().getFullYear()}</p>
    </footer>
  </div>
</Base>

<style>
  .page {
    width: min(var(--width), 100% - 2 * var(--gutter));
    margin-inline: auto;
  }

  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    padding: 0.5rem 0.75rem;
    background: var(--text);
    color: var(--bg);
  }

  .skip:focus {
    top: 1rem;
  }

  header {
    padding-top: clamp(3rem, 12vw, 6rem);
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    margin-top: 1rem;
  }

  /* Padding keeps each link an easy tap target without spreading the row out. */
  .links a {
    display: inline-block;
    padding-block: 0.5rem;
  }

  /* The section list only earns its place beside the content on wide screens. */
  .toc {
    display: none;
  }

  section {
    margin-top: 3.5rem;
  }

  /* On a phone a rule, like the one under the desktop sidebar's links, ends the header without a long gap. */
  main > section:first-child {
    margin-top: 1.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  h2 {
    scroll-margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  footer {
    margin-top: 4rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  /* Wide screens: profile in a sticky column on the left, content on the right. */
  @media screen and (min-width: 64rem) {
    .page {
      --width: 68rem;
      display: grid;
      grid-template-columns: 17rem minmax(0, 1fr);
      column-gap: clamp(3rem, 6vw, 6rem);
    }

    header {
      position: sticky;
      top: 0;
      align-self: start;
      padding-block: 6rem 2rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    .links {
      flex-direction: column;
      margin-top: 1.5rem;
    }

    .links a {
      padding-block: 0.25rem;
    }

    .toc {
      display: block;
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--rule);
      font-size: 0.9375rem;
    }

    .toc a {
      display: inline-block;
      padding-block: 0.25rem;
      color: var(--muted);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--text);
    }

    main {
      padding-top: 6rem;
    }

    main > section:first-child {
      margin-top: 0;
      padding-top: 0;
      border-top: 0;
    }

    section {
      margin-top: 5rem;
    }

    footer {
      grid-column: 2;
      margin-top: 5rem;
    }
  }

  @media print {
    header {
      padding-top: 0;
    }

    .skip,
    .toc {
      display: none;
    }
  }
</style>
