---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import portrait from '../assets/edwin.jpg';
import { profile } from '../data/profile';

const resume = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${profile.resume}`;
---

<Base>
  <a class="skip" href="#main">Skip to content</a>

  <header class="page">
    <div class="intro">
      <Picture
        src={portrait}
        alt=""
        widths={[64, 128, 192]}
        sizes="64px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="portrait"
      />
      <div>
        <h1>{profile.name}</h1>
        <p class="muted">{profile.role} in {profile.location}</p>
      </div>
    </div>

    <nav aria-label="Contact">
      <ul class="links" role="list">
        <li><a href={resume}>Resume</a></li>
        <li><a href={profile.links.github} rel="me">GitHub</a></li>
        <li><a href={profile.links.linkedin} rel="me">LinkedIn</a></li>
        <li><a href={`mailto:${profile.email}`}>Email</a></li>
      </ul>
    </nav>
  </header>

  <main id="main" class="page">
    <section aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <Experience />
    </section>

    <section aria-labelledby="projects">
      <h2 id="projects">Projects</h2>
      <Projects />
    </section>
  </main>

  <footer class="page muted">
    <p>{profile.name}, {new Date().getFullYear()}</p>
  </footer>
</Base>

<style>
  .page {
    width: min(var(--width), 100% - 2 * var(--gutter));
    margin-inline: auto;
  }

  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    padding: 0.5rem 0.75rem;
    background: var(--text);
    color: var(--bg);
  }

  .skip:focus {
    top: 1rem;
  }

  header {
    padding-top: clamp(3rem, 12vw, 6rem);
  }

  .intro {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .intro :global(.portrait) {
    flex: none;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    margin-top: 1rem;
  }

  /* Padding keeps each link an easy tap target without spreading the row out. */
  .links a {
    display: inline-block;
    padding-block: 0.5rem;
  }

  section {
    margin-top: 3.5rem;
  }

  h2 {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  footer {
    margin-top: 4rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  @media print {
    header {
      padding-top: 0;
    }

    .skip {
      display: none;
    }
  }
</style>
